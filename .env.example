# Server-only settings. None of these has a VITE_ prefix, so none of them ends up in the
# page's JavaScript. Set them in the Vercel project, and in .env.local for the scripts.

# From https://www.strava.com/settings/api. Set "Authorization Callback Domain" there to
# your domain (and to localhost when running `vercel dev`).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Strava athlete ids allowed to log in, comma-separated. The first one owns shared routes
# and is the account the scripts act for.
STRAVA_ATHLETE_IDS=

# Any long random string, used to sign the login cookie: `openssl rand -base64 32`
SESSION_SECRET=

# Upstash Redis REST endpoint and read/write token.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local development only: run on your real data instead of the demo (with `npx vercel dev`).
# VITE_REAL_DATA=1
