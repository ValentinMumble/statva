# Server-only settings. None of these has a VITE_ prefix, so none of them ends up in the
# page's JavaScript. Set them in the Vercel project, and in .env.local for the scripts.

# From https://www.strava.com/settings/api. Set "Authorization Callback Domain" there to
# your domain (and to localhost when running `vercel dev`).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Strava athlete ids allowed to log in, comma-separated. The first one is the account the
# scripts act for.
STRAVA_ATHLETE_IDS=

# Any long random string, used to sign the login cookie: `openssl rand -base64 32`
SESSION_SECRET=

# Upstash Redis REST endpoint and read/write token.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: your Komoot login, to list your planned tours in Ride weather (only for the first
# athlete above). Komoot has no open API, so this logs in like its apps do; leave empty to
# paste tour links instead.
# KOMOOT_EMAIL=
# KOMOOT_PASSWORD=

# Optional: another address of the same deployment for share links (Ride weather), such as
# https://share.example.com, so they open in the browser and not in the app installed in the
# Dock. Without it, links use the app's own address.
# VITE_SHARE_ORIGIN=

# With VITE_SHARE_ORIGIN: Statva's own address (https://statva.example.com), where riders log in,
# so a share page can show its Bookmark button to a logged-in rider and nobody else.
# VITE_APP_ORIGIN=

# Local development only: run on your real data instead of the demo (with `npx vercel dev`).
# VITE_REAL_DATA=1
